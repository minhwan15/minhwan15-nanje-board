rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 수업 코드(room)가 어떤 활동인지 한 번만 기록. 바꾸거나 지울 수 없음.
    match /rooms/{room} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['act', 'createdAt'])
        && request.resource.data.act in ['nanje', 'future', 'uam']
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // 수업 코드(room)마다 게시물 모음. 학생은 읽기와 새 글 쓰기만 가능, 수정·삭제는 불가.
    // 태블릿마다 작성 중인 내용(교실 화면 '실시간 화면'). 태블릿 하나당 문서 하나를 덮어씀
    match /rooms/{room}/drafts/{dev} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['dev', 'group', 'tab', 'data', 'updatedAt'])
        && request.resource.data.dev == dev
        && request.resource.data.group is int
        && request.resource.data.group >= 1 && request.resource.data.group <= 5
        && request.resource.data.tab is string && request.resource.data.tab.size() <= 10
        && request.resource.data.data is map
        && request.resource.data.data.size() <= 13
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /rooms/{room}/posts/{postId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['group', 'stage', 'data', 'createdAt'])
        && request.resource.data.group is int
        && request.resource.data.group >= 1 && request.resource.data.group <= 5
        && request.resource.data.stage in ['map', 'compare', 'signal', 'v1', 'rebut', 'v2', 'comment', 'free', 'p1', 'p2', 'p3', 'p4']
        && request.resource.data.data is map
        && request.resource.data.data.size() <= 12
        // 사진·그림(img)은 태블릿에서 줄인 JPEG 문자열, 50만 자 이하
        && (!('img' in request.resource.data.data)
            || (request.resource.data.data.img is string && request.resource.data.data.img.size() <= 500000))
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
  }
}
